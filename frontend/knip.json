{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ffmpeg", "py", "tsx"],
  "ignoreDependencies": [
    "electron-builder-squirrel-windows",
    "cesium",
    "electron",
    "obs-websocket-js",
    "pixelmatch",
    "playwright",
    "pngjs",
    "tsx"
  ],
  "ignoreFiles": ["src/composables/useMessageStore.ts"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "src/components/live2d/useLive2DModel.ts",
        "src/minecraft-gameplay/main.ts",
        "src/earth-prototype/main.ts",
        "electron/preload.cjs",
        "scripts/*.mjs",
        "streaming-tts-smoke.mjs"
      ],
      "project": [
        "src/**/*.{ts,vue}",
        "electron/**/*.{cjs,ts}",
        "scripts/**/*.{mjs,ts}",
        "*.{ts,mjs,cjs}"
      ]
    }
  }
}
